27Z", "toolUseResult": {"type": "text", "file": {"filePath": "/home/dev/tinycalc/tinycalc/parser.py", "content": "\"\"\"A small recursive-descent calculator: + - * / ( ) and unary minus.\"\"\"\nimport re\n\n_TOKEN = re.compile(r\"\\s*(?:(\\d+\\.?\\d*)|(.))\")\n\n\ndef tokenize(src):\n    for num, op in _TOKEN.findall(src):\n        if num:\n            yield float(num)\n        elif op.strip():\n            yield op\n\n\nclass Parser:\n    def __init__(self, tokens):\n        self.tokens = list(tokens)\n        self.pos = 0\n\n    def peek(self):\n        return self.tokens[self.pos] if self.pos < len(self.tokens) else None\n\n    def take(self):\n        tok = self.peek()\n        self.pos += 1\n        return tok\n\n    def expr(self):\n        value = self.term()\n        while self.peek() in (\"+\", \"-\"):\n            op = self.take()\n            rhs = self.term()\n            value = value + rhs if op == \"+\" else value - rhs\n        return value\n\n    def term(self):\n        value = self.factor()\n        while self.peek() in (\"*\", \"/\"):\n            op = self.take()\n            rhs = self.factor()\n            value = value * rhs if op == \"*\" else value / rhs\n        return value\n\n    def factor(self):\n        tok = self.take()\n        if tok == \"(\":\n            value = self.expr()\n            self.take()  # ')'\n            return value\n        if tok == \"-\":\n            return self.factor()\n        return tok\n\n\ndef evaluate(src):\n    return Parser(tokenize(src)).expr()\n", "numLines": 57, "startLine": 1, "totalLines": 57}}, "sourceToolAssistantUUID": "983aedfe-a772-4de6-9a38-567dd9b5fb73", "userType": "external", "entrypoint": "sdk-cli", "cwd": "/home/dev/tinycalc", "sessionId": "9d6b55b8-bae5-4a23-a938-485a2b930846", "version": "2.1.250", "gitBranch": "main"}
